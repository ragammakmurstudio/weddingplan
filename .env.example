# Supabase → Project Settings → API
SUPABASE_URL="https://PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="service-role-key-rahasia"

# openssl rand -base64 32 — set juga di Vercel → Environment Variables
AUTH_SECRET="isi-secret-acak-anda"

# lynk.id — link checkout produk akses selamanya (CTA beli/daftar)
NEXT_PUBLIC_LYNK_URL="https://lynk.id/USERNAME/PRODUCT/checkout"

# lynk.id → Dashboard → Webhook → merchant key (set juga di Vercel)
LYNK_MERCHANT_KEY=""

# URL dasar app (link reset password di email)
APP_URL="http://localhost:3000"

# Gmail SMTP (App Password dari Google Account → Security → App passwords)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="owner@gmail.com"
SMTP_PASS=""
SMTP_FROM="NikahPlan <owner@gmail.com>"
